import Base
import ./descriptor_wire.bend as W
import ./descriptors.bend as D
import ./model.bend as M
import ./messages.bend as Messages
import ./services.bend as Services
import ./options.bend as Opt
import ./request.bend as Request
import ./response.bend as Resp
import ./build/assets.bend as Assets

type Generation is Data:
  Generation{schema: D.Schema, options: Opt.Options}

def prepare(+doc: W.Doc) -> W.Checked(Generation):
  do W.Checked<Generation>:
    params : String <- W.text(doc, 2)
    options : Opt.Options <- Opt.parse(params)
    schema : D.Schema <- D.request(doc)
    return Generation{schema, options}

def finish(f: File, services: List<&2, M.Service>) -> IO(Unit):
  match services:
    case Nil{}: File.close(f)
    case Con{_, _}:
      do IO<Unit>:
        last : File <- Resp.file(f, "grpc_runtime.bend", Assets.grpc_runtime())
        File.close(last)

def generate(f: File, plan: Generation) -> IO(Unit):
  Generation{D.Schema{ms, es, +ss}, Opt.Options{name, preserve}} = plan
  imports = "# Generated by Wirequill.\nimport Base\nimport ./runtime.bend as R\nimport ./message_values.bend as V\n" ++ Services.imports(ss) ++ "\n"
  body = List.append(&1, Unit -> String, Messages.emit_chunks(ms, es, preserve), Services.emit_chunks(ss))
  do IO<Unit>:
    # supported_features = FEATURE_PROTO3_OPTIONAL.
    start : File <- Resp.binary(f, [16, 1])
    schema : File <- Resp.chunks(Con{u => imports, body}, start, name ++ ".bend", Nil{}, 0)
    runtime : File <- Resp.file(schema, "runtime.bend", Assets.runtime())
    values : File <- Resp.file(runtime, "message_values.bend", Assets.message_values())
    finish(values, ss)

def respond(f: File, result: W.Checked(Generation)) -> IO(Unit):
  match result:
    case Fail{msg}: Resp.error(f, msg)
    case Done{plan}: generate(f, plan)

def main() -> IO(Unit):
  do IO<Unit>:
    req : W.Doc <- Request.read()
    f : File <- IO.try(File, File.open("/dev/stdout", "w"))
    respond(f, prepare(req))
