import Base
import ./descriptor_wire.bend as W
import ./descriptors.bend as D
import ./model.bend as M
import ./messages.bend as Messages
import ./services.bend as Services
import ./runtime.bend as R
import ./response.bend as Resp
import ./build/assets.bend as Assets

def service_file(ss: List<&2, M.Service>) -> List<&2, Resp.Output>:
  match ss:
    case Nil{}: Nil{}
    case Con{s, t}: [Resp.Output{"grpc_runtime.bend", Assets.grpc_runtime()}]

def generate(schema: D.Schema, problem: Maybe<&2, String>) -> W.Checked(List<&2, Resp.Output>):
  match schema problem:
    case D.Schema{ms, es, +ss} None{}:
      head : String = "# Generated by Wirequill.\nimport Base\nimport ./runtime.bend as R\nimport ./message_values.bend as V\n"
      text = head ++ Services.imports(ss) ++ "\n" ++ Messages.emit(ms, es) ++ "\n" ++ Services.emit(ss)
      schema_module : Resp.Output = Resp.Output{"schema.bend", text}
      runtime_module : Resp.Output = Resp.Output{"runtime.bend", Assets.runtime()}
      values_module : Resp.Output = Resp.Output{"message_values.bend", Assets.message_values()}
      Done{schema_module <> runtime_module <> values_module <> service_file(ss)}
    case _ Some{msg}: Fail{msg}

def schema_files(+schema: D.Schema) -> W.Checked(List<&2, Resp.Output>):
  D.Schema{ms, es, ss} = schema
  generate(schema, Services.validate(ss))

def handle(r: Maybe<&2, W.Doc>) -> IO(Unit):
  match r:
    case None{}: IO.die(Unit, 1, "Malformed CodeGeneratorRequest")
    case Some{req}:
      do IO<Unit>:
        f : File <- IO.try(File, File.open("/dev/stdout", "w"))
        Resp.write(W.Checked.bind(D.Schema, List<&2, Resp.Output>, D.request(req), s => schema_files(s)), f)

def bounded(+input: List<&2, U32>, within: Bool) -> IO(Unit):
  match within:
    case False{}: IO.die(Unit, 1, "CodeGeneratorRequest exceeds 64 MiB")
    case True{}: handle(R.parse(input))

def received(pair: File & Result<&1, &1, U32 & String, List<&2, U32>>) -> IO(Unit):
  (f, r) = pair
  do IO<Unit>:
    File.close(f)
    +input : List<&2, U32> <- IO.pass(List<&2, U32>, r)
    bounded(input, Nat.is_le(List.length(&2, U32, input), 67108864n))

def main() -> IO(Unit):
  do IO<Unit>:
    f : File <- IO.try(File, File.open("/dev/stdin", "r"))
    pair : File & Result<&1, &1, U32 & String, List<&2, U32>> <- File.read_bytes(f, 67108865)
    received(pair)
